# Local workstation only. Compose reads this file after copying it to .env.
BACKEND_PORT=8080
FRONTEND_PORT=5173
# Native Go backend only; Compose uses its internal service DNS instead.
BACKEND_ADDR=127.0.0.1:8080
LIVEKIT_HTTP_URL=http://127.0.0.1:7880
# Native Vite only; Compose uses http://backend:8080 instead.
API_PROXY_TARGET=http://127.0.0.1:8080
# LiveKit --dev supplies devkey/secret. Never use these on a public server.
# Generate once with: openssl rand -hex 32
# Required; paste into the operator-key field only when creating rooms.
LOCAL_ADMIN_KEY=
APP_ORIGIN=http://localhost:5173
LIVEKIT_WS_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Generated by scripts/start-local. Dedicated server-side default-room credential.
LOCAL_PLAYER_KEY=
