{
  "name": "screen-share-player",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-22",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "assets": {
    "directory": "../../dist/screen-share-player",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/r/*", "/api/*"]
  },
  "vars": { "PLAYER_ORIGIN": "https://screen-share-player.gabrielhpittacosta.workers.dev" }
}
