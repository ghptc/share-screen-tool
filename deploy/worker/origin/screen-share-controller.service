[Unit]
Description=Screen Share private Discord room controller
Conflicts=whiterun-pilot-controller.service
After=network-online.target whiterun-pilot-controller.service
StartLimitIntervalSec=0

[Service]
Environment=SCREEN_SHARE_ENV=production DISCORD_MODE=discord SCREEN_SHARE_MEDIA_TRANSPORT=cloudflare-private
Environment=BACKEND_ADDR=127.0.0.1:18492 DISCORD_VOICE_URL=http://127.0.0.1:18491
Environment=SCREEN_SHARE_SFU_STATE_DIR=%h/.local/state/whiterun-pilot
EnvironmentFile=%h/.config/whiterun-pilot/controller.env
EnvironmentFile=%h/.config/screen-share/player.env
ExecStart=%h/.local/lib/screen-share/screen-share-controller
StateDirectory=whiterun-pilot
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
# The ownership watchdog must keep running after controller shutdown or crash.
KillMode=process
TimeoutStopSec=50s
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=default.target
