#!/usr/bin/env python3
"""Operate one saved release against this service's persistent environment."""
import os
from pathlib import Path
import re
import stat
import sys

release = Path(__file__).resolve().parent
revision = (release / "RELEASE").read_text().strip()
if not re.fullmatch("[0-9a-f]{40}", revision):
    sys.exit("Invalid release ID")
config = release.parent.parent / "shared" / "production.env"
info = config.lstat()
if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077:
    sys.exit("Protect shared/production.env with mode 0600 and run as its owner")
env = {k: os.environ[k] for k in ("PATH", "HOME", "LANG", "TERM", "XDG_RUNTIME_DIR") if k in os.environ}
env["WHITERUN_RELEASE"] = revision
os.execvpe("docker", ["docker", "compose", "--env-file", str(config), "-p", "whiterun-live-prod",
                     "-f", str(release / "compose.yaml"), *sys.argv[1:]], env)
