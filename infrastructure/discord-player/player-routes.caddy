header Referrer-Policy no-referrer
root * /srv
@room path_regexp room ^/r/[A-Za-z0-9_-]{32}$
handle @room {
	rewrite * /index.html
	file_server
}
handle /assets/* {
	file_server
}
@api path /api/discord/* /api/native-audio/*
handle @api {
	uri strip_prefix /api
	reverse_proxy backend:8080
}
@media path /rtc /rtc/validate /rtc/v1 /rtc/v1/validate
handle @media {
	reverse_proxy livekit:7880 {
		header_up -Cookie
	}
}
handle {
	respond 404
}
