index 6a70c6b..645b6f6 100644
--- a/pkg/service/roommanager.go
+++ b/pkg/service/roommanager.go
@@ -328,0 +329,3 @@ func (r *RoomManager) StartSession(
+	if protectedRoom(protoRoom.Name) && (pi.Grants == nil || !voiceAuthorized(ctx, protoRoom.Name, string(pi.Identity), pi.Grants.Video)) {
+		return rtc.ErrPermissionDenied
+	}
@@ -492,0 +496 @@ func (r *RoomManager) StartSession(
+		ScreenSlots:              &room.ScreenSlots,
@@ -575,0 +580,16 @@ func (r *RoomManager) StartSession(
+	if protectedRoom(protoRoom.Name) {
+		go func(p types.LocalParticipant, roomName string) {
+			ticker := time.NewTicker(2 * time.Second)
+			defer ticker.Stop()
+			for range ticker.C {
+				if p.IsClosed() {
+					return
+				}
+				if !voiceAuthorized(context.Background(), roomName, string(p.Identity()), p.ClaimGrants().Video) {
+					p.Close(true, types.ParticipantCloseReasonServiceRequestRemoveParticipant, false)
+					return
+				}
+			}
+		}(participant, protoRoom.Name)
+	}
+
@@ -1176,0 +1197,11 @@ func (r *RoomManager) refreshToken(participant types.LocalParticipant) error {
+	if grants.Video != nil && protectedRoom(grants.Video.Room) {
+		if !voiceAuthorized(context.Background(), grants.Video.Room, string(participant.Identity()), grants.Video) {
+			return rtc.ErrPermissionDenied
+		}
+		// Browsers reconnect through the authenticated same-origin signaling proxy.
+		// Do not deliver a bearer JWT into the browser SDK's URL-based resume path.
+		if grants.Video.GetCanSubscribe() {
+			return nil
+		}
+		validFor = 45 * time.Second
+	}
