#!/usr/bin/env python3
"""Exercise the private profile with fresh keys, without connecting a Discord bot."""
import base64
import hashlib
import hmac
import http.client
import json
import os
from pathlib import Path
import secrets
import ssl
import subprocess
import tempfile
import time
from urllib.parse import parse_qs, urlsplit

root = Path(__file__).resolve().parents[1]
env = os.environ.copy()
for key in ("DISCORD_CHANNELS", "DISCORD_CLIENT_ID", "DISCORD_CLIENT_SECRET", "DISCORD_BOT_TOKEN",
            "DISCORD_PRIVATE_ROOM_KEY", "DISCORD_PRIVATE_ADMISSION_KEY", "DISCORD_PRIVATE_VOICE_KEY",
            "DISCORD_MEDIA_KEY", "DISCORD_MEDIA_SECRET"):
    env[key] = secrets.token_hex(32)
env.update(DISCORD_CHANNELS="11/22", DISCORD_CLIENT_ID="1234", DISCORD_PRIVATE_HOST="localhost",
           DISCORD_PRIVATE_IP="", DISCORD_DENIED_USERS="")

def main(work):
    override = Path(work, "ports.yaml")
    override.write_text('services:\n  livekit:\n    ports: !reset []\n  player:\n'
                        '    ports: !override ["127.0.0.1::8443"]\n')
    project = "whiterun-private-check-" + secrets.token_hex(5)
    compose = ["docker", "compose", "--env-file", "/dev/null", "-p", project,
               "-f", "compose.discord-private.yaml", "-f", str(override)]

    def run(*args, check=True):
        result = subprocess.run([*compose, *args], cwd=root, env=env, capture_output=True)
        if check and result.returncode:
            raise RuntimeError("Compose " + args[0] + " failed")
        return result

    services = json.loads(run("config", "--format", "json").stdout)["services"]
    for service, sensitive in {
        "backend": {"DISCORD_CLIENT_SECRET", "DISCORD_ROOM_KEY", "DISCORD_ADMISSION_KEY", "DISCORD_VOICE_KEY", "LIVEKIT_API_SECRET"},
        "discord-bot": {"DISCORD_BOT_TOKEN", "DISCORD_ROOM_KEY", "DISCORD_VOICE_KEY"},
        "livekit": {"LIVEKIT_KEYS", "DISCORD_ADMISSION_KEY"},
        "player": set(),
    }.items():
        names = set(services[service]["environment"])
        actual = {n for n in names if n.endswith(("_SECRET", "_KEY", "_TOKEN", "_KEYS"))}
        # The backend's LiveKit key ID is public inside the backend trust boundary.
        if actual - {"LIVEKIT_API_KEY"} != sensitive or any(n.startswith(("LOCAL_", "DISCORD_FIXTURE")) for n in names):
            raise RuntimeError("unexpected private service credentials")
    try:
        print("Building and starting isolated private backend, SFU and HTTPS player", flush=True)
        run("up", "-d", "--build", "--wait", "--wait-timeout", "90", "livekit", "backend", "player")
        cert = run("exec", "-T", "player", "cat", "/data/caddy/pki/authorities/local/root.crt").stdout
        tls = ssl.create_default_context(cadata=cert.decode())
        port = int(run("port", "player", "8443").stdout.decode().rsplit(":", 1)[1])

        def request(method, path):
            conn = http.client.HTTPSConnection("localhost", port, context=tls, timeout=5)
            try:
                conn.request(method, path, body="{}" if method == "POST" else None,
                             headers={"Origin": "https://localhost:8443", "Content-Type": "application/json"})
                res = conn.getresponse()
                return res.status, res.getheader("Location", ""), res.read()
            finally:
                conn.close()

        digest = hmac.digest(env["DISCORD_PRIVATE_ROOM_KEY"].encode(), b"whiterun:discord:voice:v1/11/22", hashlib.sha256)
        ref = base64.urlsafe_b64encode(digest[:24]).decode()
        if request("GET", "/r/" + ref)[0] != 200 or request("POST", "/api/discord/" + ref + "/join")[0] != 401:
            raise RuntimeError("room page or copied-link access control failed")
        for path in ["/", "/api/internal/discord/admit", "/player/join", "/api/fixture/authorize", "/readyz"]:
            if request("GET", path)[0] != 404:
                raise RuntimeError("private edge exposed an unexpected route")
        status, location, _ = request("GET", "/api/discord/auth/" + ref)
        q = parse_qs(urlsplit(location).query)
        if (status != 303 or urlsplit(location).netloc != "discord.com" or q.get("scope") != ["identify"]
                or q.get("redirect_uri") != ["https://localhost:8443/api/discord/callback"]
                or q.get("code_challenge_method") != ["S256"]):
            raise RuntimeError("unexpected private OAuth redirect")
        health = ("exec", "-T", "backend", "/server", "healthcheck")
        run(*health, "http://127.0.0.1:8080/readyz")
        print("Private TLS, room entry denial, OAuth redirect, route isolation and authenticated SFU admission passed", flush=True)
        env["DISCORD_PRIVATE_ADMISSION_KEY"] = secrets.token_hex(32)
        run("up", "-d", "--no-deps", "--force-recreate", "backend")
        for _ in range(30):
            if not run(*health, "http://127.0.0.1:8080/healthz", check=False).returncode:
                break
            time.sleep(0.2)
        else:
            raise RuntimeError("backend liveness failed")
        if not run(*health, "http://127.0.0.1:8080/readyz", check=False).returncode:
            raise RuntimeError("mismatched admission credential accepted")
        print("Live backend rejected private readiness after the SFU callback credential changed", flush=True)
    finally:
        run("down", "--volumes", "--rmi", "local")

if __name__ == "__main__":
    with tempfile.TemporaryDirectory() as work:
        main(work)
