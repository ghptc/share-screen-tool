#!/usr/bin/env bash
# Hardware integration against a separate SFU, API, browser origin and launcher.
set -euo pipefail
cd "$(dirname "$0")/.."
: "${PLAYER_AUDIO_TEST_SINK:?Name the physical headset sink to receive the quiet test tones}"
unset NATIVE_AUDIO_SINK # Whole-output diagnostic has a separate opt-in run.
umask 077
work="$(mktemp -d)"
mkdir "$work/socket"
export APP_ORIGIN=http://localhost:15173 E2E_BASE_URL=http://localhost:15173
LOCAL_ADMIN_KEY="$(openssl rand -hex 32)"
LOCAL_PLAYER_KEY="$(openssl rand -hex 32)"
PLAYER_UID="$(id -u)"
PLAYER_GID="$(id -g)"
export LOCAL_ADMIN_KEY LOCAL_PLAYER_KEY PLAYER_UID PLAYER_GID E2E_OPERATOR_KEY="$LOCAL_ADMIN_KEY"
cat > "$work/compose.yaml" <<YAML
services:
  livekit:
    ports: !override ["127.0.0.1:17880:7880", "127.0.0.1:17881:7881", "127.0.0.1:17882:7882/udp"]
  backend:
    ports: !reset []
    environment:
      LIVEKIT_WS_URL: ws://127.0.0.1:17880
  frontend:
    ports: !override ["127.0.0.1:15173:5173"]
    volumes: !override ["$work/socket:/desktop:ro"]
YAML
overlays=()
if [[ "${DISCORD_VALIDATION:-0}" == 1 ]]; then
  for key in DISCORD_ROOM_KEY DISCORD_VOICE_KEY DISCORD_ADMISSION_KEY DISCORD_CLIENT_SECRET DISCORD_FIXTURE_KEY; do
    printf -v "$key" '%s' "$(openssl rand -hex 32)"
    export "${key?}"
  done
  export DISCORD_FIXTURE_PORT=18191 DISCORD_FIXTURE_URL=http://127.0.0.1:18191
  export DISCORD_TEST_PROJECT="whiterun-audio-test-$$"
  overlays=(-f compose.discord-dev.yaml)
fi
compose=(docker compose -p "whiterun-audio-test-$$" -f compose.yaml "${overlays[@]}" -f "$work/compose.yaml")
launcher_pid=''
cleanup() {
  if [[ -n "$launcher_pid" ]]; then kill "$launcher_pid" 2>/dev/null || true; wait "$launcher_pid" 2>/dev/null || true; fi
  "${compose[@]}" down --rmi local
  rm -f "$work/socket/launcher.sock" "$work/launcher" "$work/compose.yaml"
  rmdir "$work/socket" "$work"
}
trap cleanup EXIT
(cd native-audio && go build -o "$work/launcher" .)
systemd-socket-activate -l "$work/socket/launcher.sock" -E XDG_RUNTIME_DIR -E PATH "$work/launcher" --desktop-launcher --player-origin "$APP_ORIGIN" &
launcher_pid=$!
"${compose[@]}" up -d --build --wait
(cd frontend && npm run build)
status=0
SAME_HEADSET_PLAYER=1 SAME_HEADSET_HELPER="$work/launcher" SAME_HEADSET_SINK="$PLAYER_AUDIO_TEST_SINK" SAME_HEADSET_CLEANUP=helper-killed \
  node native-audio/scripts/same-headset-run.mjs || status=1
for engine in chromium firefox; do
  (cd frontend && E2E_BROWSER="$engine" npm run test:e2e -- --output="test-results/$engine") || status=1
done
exit "$status"
